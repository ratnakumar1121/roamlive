# =============================================================================
# RoamLive Environment Configuration Template
# =============================================================================
# Copy this file to .env and update with your actual values
# Never commit .env to version control!

# =============================================================================
# Server Configuration
# =============================================================================
PORT=3000
NODE_ENV=development
HOST=localhost

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL Connection URL
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://roamlive_user:your_password@localhost:5432/roamlive

# Alternative database configuration (if not using DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=roamlive
DB_USER=roamlive_user
DB_PASSWORD=your_password
DB_SSL=false

# =============================================================================
# Authentication & Security
# =============================================================================
# JWT Secret - Use a strong, random secret in production
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secure-jwt-secret-key-change-this-in-production

# JWT Token Expiration
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# bcrypt Salt Rounds (10-12 recommended for production)
BCRYPT_SALT_ROUNDS=10

# =============================================================================
# Rate Limiting
# =============================================================================
# Time window in milliseconds (15 minutes = 900000ms)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100

# Auth-specific rate limiting (stricter)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# =============================================================================
# CORS Configuration
# =============================================================================
# Allowed origins for CORS (comma-separated)
# In development: http://localhost:3000
# In production: https://yourdomain.com
CORS_ORIGIN=http://localhost:3000

# =============================================================================
# WebSocket Configuration
# =============================================================================
# Maximum connections per IP
SOCKET_MAX_CONNECTIONS=10

# Connection timeout in milliseconds
SOCKET_TIMEOUT=20000

# =============================================================================
# File Upload Configuration
# =============================================================================
# Maximum file size in bytes (5MB = 5242880)
MAX_FILE_SIZE=5242880

# Allowed file types (comma-separated)
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,audio/mpeg,audio/wav

# Upload directory
UPLOAD_DIR=uploads

# =============================================================================
# External Services
# =============================================================================
# Map Tiles Service (optional)
MAP_TILES_API_KEY=your-map-tiles-api-key

# Push Notification Service (optional)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:your-email@example.com

# Email Service (optional)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# =============================================================================
# Logging
# =============================================================================
# Log level: error, warn, info, debug
LOG_LEVEL=info

# Log file path (optional)
LOG_FILE=logs/roamlive.log

# =============================================================================
# Performance & Monitoring
# =============================================================================
# Enable/disable request logging
ENABLE_REQUEST_LOGGING=true

# Session timeout in milliseconds (30 minutes = 1800000ms)
SESSION_TIMEOUT=1800000

# =============================================================================
# Development Configuration
# =============================================================================
# Enable debug mode
DEBUG=false

# Enable hot reload
HOT_RELOAD=true

# =============================================================================
# Production Configuration
# =============================================================================
# Trust proxy (set to true if behind reverse proxy)
TRUST_PROXY=false

# Secure headers
ENABLE_HELMET=true

# HTTPS redirect
FORCE_HTTPS=false

# =============================================================================
# Database Pool Configuration
# =============================================================================
# Connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_ACQUIRE_TIMEOUT=60000
DB_POOL_IDLE_TIMEOUT=10000

# =============================================================================
# Cache Configuration (Redis - optional)
# =============================================================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
CACHE_TTL=3600

# =============================================================================
# Analytics & Metrics (optional)
# =============================================================================
# Google Analytics
GA_TRACKING_ID=UA-XXXXXXXXX-X

# Application Insights
APPINSIGHTS_INSTRUMENTATIONKEY=your-app-insights-key

# =============================================================================
# Feature Flags
# =============================================================================
# Enable/disable features
FEATURE_VOICE_MESSAGES=false
FEATURE_VIDEO_CALLING=false
FEATURE_FILE_SHARING=true
FEATURE_PUSH_NOTIFICATIONS=false
FEATURE_ANALYTICS=false

# =============================================================================
# Deployment Configuration
# =============================================================================
# Build configuration
BUILD_TARGET=production
SOURCE_MAP=false

# Health check endpoint
HEALTH_CHECK_ENABLED=true

# =============================================================================
# Example Values for Quick Setup
# =============================================================================
# Uncomment and modify these for a quick development setup:

# PORT=3000
# NODE_ENV=development
# DATABASE_URL=postgresql://postgres:password@localhost:5432/roamlive_dev
# JWT_SECRET=dev-secret-change-in-production-32-chars-min
# CORS_ORIGIN=http://localhost:3000